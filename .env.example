# Environment Configuration for Payment Verification

# Add these to your .env file:

# ===== PAYMENT VERIFICATION EMAIL =====
# Gmail account for sending payment verification emails to admin
PAYMENT_VERIFICATION_EMAIL=your-admin-email@gmail.com

# Gmail app password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=your-app-password-here

# UPI address to display to customers for manual payment
UPI_PAYMENT_ADDRESS=yourname@paytm

# Backend URL for generating email verification links
BACKEND_URL=http://localhost:3000

# ===== FIREBASE CLOUD MESSAGING (FCM) =====
# FCM is already initialized in your firebase.config.ts
# Just ensure your Firebase project has FCM enabled
# and your service account JSON is properly configured
